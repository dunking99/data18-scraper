    if (j.phase === "running") { $("s-info").textContent = `Scraping studios... page ${j.page}, ${j.count} so far`; continue; }
    if (j.phase === "error") $("s-info").textContent = j.error + (j.needs_setup ? "  (then reload this page)" : "");
    else await loadStudios();
