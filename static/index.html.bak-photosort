    const img = document.createElement("img"); img.src = c.thumbnail || ""; img.referrerPolicy = "no-referrer"; img.style.cssText = "width:64px;height:36px;object-fit:cover;border-radius:4px;background:var(--line);flex:none";
    const a = document.createElement("a"); a.href = "#"; a.className = "nm"; a.textContent = c.name; a.addEventListener("click", e => { e.preventDefault(); $("name").value = c.slug; showTab("perf"); run(false); });
    const cnt = document.createElement("span"); cnt.className = "cnt"; cnt.textContent = `${c.videos} videos` + (c.with_model ? ` · ${c.with_model} with model results` : "");
    const d = document.createElement("span"); d.className = "slug"; d.textContent = "scraped " + new Date(c.scraped * 1000).toLocaleDateString(undefined, {day: "numeric", month: "short", year: "numeric"});
    row.append(img, a, cnt, d); return row;
  }));
}
$("c-q").addEventListener("input", renderCreators);

async function loadStudios() {
  const d = await (await fetch(BASE + "api/studios")).json();
  S.all = d.studios; S.loaded = true; S.scraped = d.scraped_at;
  const parents = new Map();
  for (const s of S.all) if (s.parent) parents.set(s.parent, (parents.get(s.parent) || 0) + 1);
  const opts = [...parents].map(([slug, n]) => [slug, S.all.find(x => x.slug === slug)?.name || slug, n]).sort((a, b) => a[1].localeCompare(b[1]));
  $("s-parent").replaceChildren(new Option("Any channel", ""), ...opts.map(([slug, name, n]) => new Option(`${name} (${n} sub-channels)`, slug)));
  renderStudios();
}

function renderStudios() {
  const q = $("s-q").value.trim().toLowerCase(), type = $("s-type").value, parent = $("s-parent").value, sort = $("s-sort").value;
  let rows = S.all.filter(s =>
    (!q || s.name.toLowerCase().includes(q) || s.slug.includes(q) || (s.parent_name || "").toLowerCase().includes(q)) &&
    (type === "all" || (type === "top" ? !s.parent : !!s.parent)) &&
    (!parent || s.parent === parent || s.slug === parent));
  const byName = (a, b) => a.name.localeCompare(b.name, undefined, {sensitivity:"base", numeric:true});
  const cmp = { az:byName, za:(a, b) => byName(b, a), most:(a, b) => b.scenes - a.scenes || byName(a, b), least:(a, b) => a.scenes - b.scenes || byName(a, b) }[sort];
  if (S.group) {
    // children sit under their parent; groups follow the chosen sort, using the parent's figures
    const key = s => s.parent || s.slug;
    const head = new Map(S.all.filter(s => !s.parent).map(s => [s.slug, s]));
    const groups = new Map();
    for (const s of rows) { const k = key(s); if (!groups.has(k)) groups.set(k, []); groups.get(k).push(s); }
    const order = [...groups].sort(([ka], [kb]) => cmp(head.get(ka) || groups.get(ka)[0], head.get(kb) || groups.get(kb)[0]));
    rows = order.flatMap(([, items]) => items.sort((a, b) => (a.parent ? 1 : 0) - (b.parent ? 1 : 0) || cmp(a, b)));
  } else rows.sort(cmp);

  const total = S.all.length, subs = S.all.filter(s => s.parent).length;
  $("s-count").textContent = rows.length === total ? `${total} studios` : `${rows.length} / ${total} studios`;
  $("s-info").textContent = total ? `${total - subs} top-level · ${subs} sub-channels · last scraped ${S.scraped || "never"}` : "No studios saved yet. Click \"Re-scrape from data18\".";
  $("s-group").classList.toggle("on", S.group);

  const frag = document.createDocumentFragment();
  for (const s of rows) {
    const row = document.createElement("div");
    row.className = "srow" + (S.group && s.parent ? " child" : "") + (S.group && !s.parent ? " parentrow" : "");
    const a = document.createElement("a"); a.className = "nm"; a.href = s.url; a.target = "_blank"; a.rel = "noopener"; a.textContent = s.name;
    row.append(a);
    if (s.parent && !S.group) {
      const via = document.createElement("button"); via.type = "button"; via.className = "chip via"; via.style.setProperty("--h", catHue(s.parent));
      via.textContent = "↳ " + s.parent_name; via.title = "Show only this channel's sub-channels";
      via.addEventListener("click", () => { $("s-parent").value = s.parent; renderStudios(); });
      row.append(via);
    }
    const cnt = document.createElement("span"); cnt.className = "cnt"; cnt.textContent = s.scenes.toLocaleString() + " scenes";
    row.append(cnt);
    frag.append(row);
  }
  $("s-list").replaceChildren(frag);
}

for (const id of ["s-q", "s-type", "s-parent", "s-sort"]) $(id).addEventListener("input", renderStudios);
$("s-group").addEventListener("click", () => { S.group = !S.group; renderStudios(); });
$("s-copy").addEventListener("click", async () => {
  const q = $("s-q").value.trim().toLowerCase();
  const urls = [...document.querySelectorAll("#s-list a.nm")].map(a => a.href).join("\n");
  await navigator.clipboard.writeText(urls);
  $("s-copy").textContent = "Copied"; setTimeout(() => $("s-copy").textContent = "Copy links", 1200);
});
$("s-refresh").addEventListener("click", async () => {
  $("s-refresh").disabled = true; $("s-info").textContent = "Scraping studios...";
  await fetch(BASE + "api/studios/refresh");
  for (;;) {
    await new Promise(r => setTimeout(r, 1000));
