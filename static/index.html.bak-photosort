// ================= Tags tab =================
const T = { all:[], only:false, open:new Set(), vids:new Map() };

async function loadTags() {
  const d = await (await fetch(BASE + "api/tags")).json();   // refreshed every visit: new videos change the counts
  T.all = d.tags; T.scrapedAt = d.scraped_at; T.unlisted = d.unlisted || [];
  renderTags();
}

function renderTags() {
  const q = $("t-q").value.trim().toLowerCase(), sort = $("t-sort").value;
  let rows = T.all.filter(t => (!q || t.name.toLowerCase().includes(q) || t.slug.includes(q)) && (!T.only || t.videos));
  rows = rows.slice().sort(sort === "most"
    ? (a, b) => b.videos - a.videos || a.name.localeCompare(b.name)
    : (a, b) => a.name.localeCompare(b.name, undefined, {sensitivity:"base"}));
  const withVideos = T.all.filter(t => t.videos).length;
  $("t-count").textContent = rows.length === T.all.length ? `${T.all.length} tags` : `${rows.length} / ${T.all.length} tags`;
  $("t-info").textContent = T.all.length
    ? `${withVideos} have videos from your scraped performers` + (T.unlisted.length ? ` · ${T.unlisted.length} tags on videos aren't in the list` : "")
    : "No tags saved yet.";
  $("t-only").classList.toggle("on", T.only);
  $("t-list").replaceChildren(...rows.map(tagRow));
}

function tagRow(t) {
  const row = document.createElement("div"); row.className = "trow" + (t.videos ? "" : " empty");
  const head = document.createElement("button"); head.type = "button"; head.className = "thead";
  head.setAttribute("aria-expanded", String(T.open.has(t.slug)));
  const arrow = document.createElement("span"); arrow.className = "arrow"; arrow.textContent = t.videos ? "▸" : "";
  const nm = document.createElement("span"); nm.className = "nm"; nm.textContent = t.name;
  const cnt = document.createElement("span"); cnt.className = "cnt"; cnt.textContent = t.videos ? `${t.videos} video${t.videos === 1 ? "" : "s"}` : "0";
  const link = document.createElement("a"); link.className = "tlink"; link.href = t.url; link.target = "_blank"; link.rel = "noopener"; link.textContent = "data18 ↗";
  link.addEventListener("click", e => e.stopPropagation());
  head.append(arrow, nm, link, cnt);
  row.append(head);
  if (t.videos) {
    head.addEventListener("click", () => toggleTag(t, row, head));
    if (T.open.has(t.slug)) fillTag(t, row);
  }
  return row;
}

async function toggleTag(t, row, head) {
  if (T.open.has(t.slug)) { T.open.delete(t.slug); row.querySelector(".tvids")?.remove(); head.setAttribute("aria-expanded", "false"); return; }
  T.open.add(t.slug); head.setAttribute("aria-expanded", "true"); fillTag(t, row);
}

async function fillTag(t, row) {
  const box = document.createElement("div"); box.className = "tvids"; box.textContent = "Loading...";
  row.append(box);
  if (!T.vids.has(t.slug)) T.vids.set(t.slug, (await (await fetch(BASE + "api/tag-videos?slug=" + encodeURIComponent(t.slug))).json()).videos);
  if (!box.isConnected) return;
  box.replaceChildren(...T.vids.get(t.slug).map(v => {
    const d = document.createElement("div"); d.className = "tv";
    const img = document.createElement("img"); img.src = v.thumbnail; img.loading = "lazy"; img.referrerPolicy = "no-referrer";
    const info = document.createElement("div");
    const a = document.createElement("a"); a.href = v.url; a.target = "_blank"; a.rel = "noopener"; a.textContent = v.title;
    const meta = document.createElement("div"); meta.className = "meta";
    meta.textContent = [v.date, v.studio, "scraped from " + v.scraped_from.join(", ")].filter(Boolean).join(" · ");
    info.append(a, meta); d.append(img, info);
    return d;
  }));
}

$("t-q").addEventListener("input", renderTags);
$("t-sort").addEventListener("input", renderTags);
$("t-only").addEventListener("click", () => { T.only = !T.only; renderTags(); });


// ================= Pornstars tab =================
// rows from the server: [slug, name, picture, scenes, movies, rank]
const P = { all:[], loaded:false, only:false, shown:0, rows:[] };
const BATCH = 120;

async function loadStars() {
  $("p-info").textContent = "Loading...";
  const d = await (await fetch(BASE + "api/pornstars")).json();
  P.all = d.stars.map(([slug, name, pic, scenes, movies, rank]) => ({slug, name, pic, scenes, movies, rank, key:name.toLowerCase()}));
  P.loaded = true; P.scrapedAt = d.scraped_at;
  renderStars();
}

function renderStars() {
  const q = $("p-q").value.trim().toLowerCase(), sort = $("p-sort").value;
  let rows = P.all.filter(x => (!q || x.key.includes(q)) && (!P.only || x.pic));
  const az = (a, b) => a.key < b.key ? -1 : a.key > b.key ? 1 : 0;
  rows = rows.slice().sort({ site:(a, b) => b.rank - a.rank, az, za:(a, b) => az(b, a),
                            most:(a, b) => b.scenes - a.scenes || az(a, b) }[sort]);
  P.rows = rows; P.shown = 0;
  const withPic = P.all.filter(x => x.pic).length;
  $("p-count").textContent = rows.length === P.all.length ? `${P.all.length.toLocaleString()} pornstars` : `${rows.length.toLocaleString()} / ${P.all.length.toLocaleString()}`;
  $("p-info").textContent = P.all.length
    ? `${withPic.toLocaleString()} with a photo · last scraped ${P.scrapedAt}`
    : 'No pornstars saved yet. Click "Re-scrape from data18" (takes about 2 minutes).';
  $("p-pics").classList.toggle("on", P.only);
  $("p-grid").replaceChildren();
  showMoreStars();
}

function showMoreStars() {
  const next = P.rows.slice(P.shown, P.shown + BATCH);
  P.shown += next.length;
  const frag = document.createDocumentFragment();
  for (const x of next) {
    const a = document.createElement("a"); a.className = "pcard"; a.href = "https://www.data18.com/name/" + x.slug; a.target = "_blank"; a.rel = "noopener";
    const pic = document.createElement("div"); pic.className = "pic";
    if (x.pic) { const img = document.createElement("img"); img.src = x.pic; img.alt = ""; img.loading = "lazy"; img.referrerPolicy = "no-referrer"; pic.append(img); }
    else pic.textContent = x.name.split(/\s+/).slice(0, 2).map(w => w[0] || "").join("").toUpperCase();
    const n = document.createElement("div"); n.className = "pn"; n.textContent = x.name;
    const sc = document.createElement("div"); sc.className = "ps"; sc.textContent = `${x.scenes.toLocaleString()} scene${x.scenes === 1 ? "" : "s"}`;
    a.append(pic, n, sc); frag.append(a);
  }
  $("p-grid").append(frag);
  $("p-more").textContent = P.shown < P.rows.length ? `Showing ${P.shown.toLocaleString()} of ${P.rows.length.toLocaleString()}. Scroll or click here for more` : (P.rows.length ? "" : "No matches");
}
// load the next batch as the bottom comes into view (observer, with a scroll listener as backup)
function fillStars() {
  while (!$("pg-stars").hidden && P.shown < P.rows.length && $("p-more").getBoundingClientRect().top < innerHeight + 600) showMoreStars();
}
new IntersectionObserver(es => { if (es[0].isIntersecting) fillStars(); }, {rootMargin:"600px"}).observe($("p-more"));
$("p-more").addEventListener("click", () => { for (let i = 0; i < 4 && P.shown < P.rows.length; i++) showMoreStars(); });
let fillQueued = false;
addEventListener("scroll", () => { if (!fillQueued) { fillQueued = true; setTimeout(() => { fillQueued = false; fillStars(); }, 80); } }, {passive:true});

let pTimer;
$("p-q").addEventListener("input", () => { clearTimeout(pTimer); pTimer = setTimeout(renderStars, 150); });
$("p-sort").addEventListener("input", renderStars);
$("p-pics").addEventListener("click", () => { P.only = !P.only; renderStars(); });
$("p-refresh").addEventListener("click", async () => {
  $("p-refresh").disabled = true; $("p-info").textContent = "Scraping...";
  await fetch(BASE + "api/pornstars/refresh");
  for (;;) {
    await new Promise(r => setTimeout(r, 1000));
    const j = await (await fetch(BASE + "api/pornstars/job")).json();
    if (j.phase === "running") { $("p-info").textContent = `Scraping... page ${j.page} of about 560, ${j.count.toLocaleString()} so far`; continue; }
    if (j.phase === "error") { $("p-info").textContent = j.error + (j.needs_setup ? "  (then reload this page)" : ""); break; }
    await loadStars(); break;
  }
  $("p-refresh").disabled = false;
});
